<form class="contact-form card-soft" method="post" action="https://api.web3forms.com/submit" data-mailto="{{ site.email }}" data-success="{{ site.form.success_message }}">
  <h3>Pošaljite nam poruku</h3>
  <input type="hidden" name="access_key" value="{{ site.form.web3forms_access_key }}">
  <input type="hidden" name="subject" value="Novi upit s termteam.hr{% if title %} ({{ title }}){% endif %}">
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">
  <label><span class="sr-only">Ime i prezime</span><input name="name" type="text" placeholder="Hrvoje Horvat" required autocomplete="name"></label>
  <label><span class="sr-only">Email</span><input name="email" type="email" placeholder="hrvoje@mail.com" required autocomplete="email"></label>
  <label><span class="sr-only">Telefon</span><input name="phone" type="tel" placeholder="091 234 5678" autocomplete="tel"></label>
  <label class="select"><span class="sr-only">Usluga</span>
    <select name="usluga">
      <option value="" selected disabled>Usluga</option>
      {%- for o in site.form.space_options %}<option>{{ o }}</option>{% endfor %}
    </select>
  </label>
  <label><span class="sr-only">Poruka</span><textarea name="message" rows="4" placeholder="Kako možemo pomoći?" required></textarea></label>
  <button class="btn btn-yellow btn-block" type="submit">Pošalji</button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
