---
layout: base.njk
title: O nama
useSiteTitle: true
permalink: /about-us/
---
{%- from "partials/icons.njk" import icon -%}
{% set heroTitle = about.title %}{% set heroText = about.text %}{% set heroImage = about.hero_image %}
{% include "page-hero.njk" %}
<section class="section">
  <div class="container split">
    <div class="photo-card since">
      <img src="{{ about.since_image | img(1000) }}" alt="" loading="lazy">
      <span><small>{{ about.since_label }}</small>{{ about.since_year }}</span>
    </div>
    <div>
      <h2 class="h2">{{ about.why_title }}</h2>
      <div class="lead">{{ about.why_text | md | safe }}</div>
      <ul class="checklist">
        {%- for p in about.points %}<li>{{ icon("check", 20) }}<span>{{ p }}</span></li>{% endfor %}
      </ul>
    </div>
  </div>
</section>
<section class="section band-light">
  <div class="container">
    <div class="edu-head">
      <h2 class="h2">{{ about.edu_title }}</h2>
      <p class="lead">{{ about.edu_text }}</p>
    </div>
    <div class="edu-cards">
      {%- for c in about.cards %}
      <article class="edu-card">
        <img src="{{ c.image | img(900) }}" alt="" loading="lazy">
        <h3>{{ c.title }}</h3>
        <p>{{ c.text }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
